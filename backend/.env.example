# LocalGO FastAPI backend — copy to `.env` (gitignored) and fill in.
#
# Supabase project shared by BOTH apps (same values as the apps' .env.local,
# without the EXPO_PUBLIC_ prefix). Dashboard -> Project Settings -> API.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Backend-only Supabase secret key (sb_secret_...) or legacy service_role JWT.
# Keep this existing variable name for either format. Required for server-cart
# writes/checkout and privileged account/notification operations; never expose
# it in EXPO_PUBLIC_* configuration or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=

# Enable only after all three cart/checkout/history migrations are verified.
# Also switches checkout/order publication to authenticated locked cart snapshots.
SERVER_CART_ENABLED=false

# Groq API key — powers every Goer agent (guard, router, and the six
# specialists). Get one at https://console.groq.com/keys. Leave blank and the
# consumer app simply stays in offline-NLU mode.
GROQ_API_KEY=

# Optional Goer tuning. Defaults shown.
GOER_MODEL=llama-3.1-8b-instant
GOER_TEMPERATURE=0.4
GOER_MAX_TOKENS=700
GOER_MAX_HISTORY=12
# Where ChromaDB persists the menu/FAQ embeddings. Blank = app/goer/chroma_db.
CHROMA_PATH=

# --- Stripe (checkout) -------------------------------------------------------
# Dashboard -> Developers -> API keys. Use the TEST keys (sk_test_/pk_test_)
# until you are ready to take real money.
#   * The secret key must never leave the server - it is what creates and
#     verifies PaymentIntents. It is NOT an EXPO_PUBLIC_ value and must never
#     appear in app.json, eas.json, or any client file.
#   * The publishable key is handed to the app by POST /payments/intent, so the
#     app needs no Stripe env var of its own.
# With both blank, STRIPE_CONFIGURED is false and checkout stays in demo mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Dashboard -> Developers -> Webhooks -> your endpoint -> signing secret
# (whsec_...). Only needed for POST /payments/webhook, which catches charges
# that succeeded but whose order never reached us (app killed mid-checkout).
STRIPE_WEBHOOK_SECRET=

# --- Email (delivery receipts) -----------------------------------------------
# Used for exactly one message: when a driver confirms pickup, the customer is
# mailed the photo the driver just took of their order. Plain SMTP, so any
# provider works — SES, Resend, Postmark, Mailgun, or a Gmail account with an
# App Password (Google account -> Security -> 2-Step Verification -> App
# passwords; your normal password will NOT work).
#   Gmail:  smtp.gmail.com : 587
#   Resend: smtp.resend.com : 587   (SMTP_USER=resend, password = API key)
# All four of HOST/USER/PASSWORD/FROM must be set or EMAIL_CONFIGURED stays
# false and pickup simply skips the email, exactly as it does today.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Envelope sender. Blank falls back to SMTP_USER, which most providers require
# the From address to match anyway.
SMTP_FROM=
SMTP_FROM_NAME=LocalGO
# Set to 1 for implicit TLS on port 465. Blank/0 uses STARTTLS on 587.
SMTP_USE_SSL=
