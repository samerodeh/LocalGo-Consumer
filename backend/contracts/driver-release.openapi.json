    "/orders/{order_id}/accept": {
      "post": {
        "summary": "Accept Order",
        "description": "Atomic claim: stamps accepted_by only while the order is unclaimed.\nLosing the race returns 409 so the app can drop the card locally.",
        "operationId": "accept_order_orders__order_id__accept_post",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Order Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
