# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# FastAPI backend
# Covers .env, .env.bak, .env.local — anything but the committed template.
# A stray backend/.env.bak holding a live STRIPE_SECRET_KEY was one `git add -A`
# away from being committed before this pattern existed.
backend/.env
backend/.env.*
!backend/.env.example
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
# Generated at first index build (embeddings, ~MBs) — rebuilt on startup.
backend/app/goer/chroma_db/

# Agent/editor config - kept locally, excluded from git and EAS builds
.claude/
