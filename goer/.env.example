OPENAI_API_KEY=your_openai_api_key_here
MODEL=openai/gpt-4.1-mini
# LocalGo backend (not this Goer server). Remote URLs must use HTTPS.
LOCALGO_API_URL=http://127.0.0.1:8100
# Enable only after migrations and signed-in mobile integration are verified.
GOER_CART_ENABLED=false
# Optional Expo web preview origins, comma-separated. Native apps do not use CORS.
GOER_ALLOWED_ORIGINS=

# Conversation + turn journal storage. Empty = local SQLite file (development,
# single process). Set a Postgres URL for hosted/multi-host deployments; tables
# are created in a private "goer" schema (not exposed by Supabase's REST API).
GOER_DATABASE_URL=
# Local SQLite file used when GOER_DATABASE_URL is empty.
# GOER_CONVERSATION_DB=~/.localgo/goer/conversations.sqlite3
# Create/upgrade the Postgres schema at startup (set false if migrations are managed separately).
GOER_DB_AUTO_MIGRATE=true
# Conversations inactive this many days are deleted (checked at startup and daily).
GOER_RETENTION_DAYS=90

# Langfuse tracing (optional; disabled when keys are empty).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
